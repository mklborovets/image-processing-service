{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs|uuid)/)"
  ],
  "moduleNameMapper": {
    "^@nestjs/terminus$": "<rootDir>/__mocks__/terminus.js"
  }
}
